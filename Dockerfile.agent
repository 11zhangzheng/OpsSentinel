FROM python:3.12-slim
WORKDIR /app
# docker.io supplies the CLI; Debian's compose plugin availability varies.
# Copy the official CLI and compose plugin without starting a Docker daemon.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:27-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY pyproject.toml README.md ./
COPY opssentinel ./opssentinel
RUN pip install --no-cache-dir .
ENV PYTHONUNBUFFERED=1
EXPOSE 9876
# Requires explicitly mounted config, state, compose project paths and Docker
# socket. Socket access is privileged; native Linux deployment is simpler.
ENTRYPOINT ["python", "-m", "opssentinel.host_agent"]
CMD ["--config", "/config/agent.yaml", "--host", "0.0.0.0", "--port", "9876"]
