# Docker Compose automatically reads .env. Direct Python execution does not.
# Copy this file to .env and provide your own values; never commit real tokens.
# Required for non-loopback controller binding, including the controller container.
OPS_API_TOKEN=
# Actual controller hostnames/IPs allowed in HTTP Host, comma-separated, no ports.
# Localhost is allowed by default; configure this when using a remote hostname.
OPS_ALLOWED_HOSTS=

# Optional OpenAI-compatible diagnostic suggestions. Leave all three empty for rules only.
OPS_MODEL_BASE_URL=
OPS_MODEL_API_KEY=
OPS_MODEL_NAME=

# Set independently on the Linux host agent, at least 24 random characters.
# This is not passed to the controller container by compose.yaml.
OPS_AGENT_TOKEN=
